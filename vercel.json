{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "embedded",
          "value": "true"
        }
      ],
      "destination": "http://113.250.181.154:6006/"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "http://113.250.181.154:6006/$1"
    }
  ]
}
